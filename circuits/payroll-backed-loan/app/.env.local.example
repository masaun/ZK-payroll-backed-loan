# Reclaim Protocol Environment Variables
# 
# Get your credentials from: https://dev.reclaimprotocol.org/
# Follow the guide: https://docs.reclaimprotocol.org/api-key

# Required: Your Reclaim Protocol Application ID (CLIENT-SIDE)
# Note: NEXT_PUBLIC_ prefix makes this available on client-side
NEXT_PUBLIC_RECLAIM_APP_ID=your_app_id_here

# Required: Your Reclaim Protocol Application Secret (CLIENT-SIDE)
# Note: NEXT_PUBLIC_ prefix makes this available on client-side
# In production, consider using server-side creation if secrets should be hidden
NEXT_PUBLIC_RECLAIM_APP_SECRET=your_app_secret_here

# Required: Provider ID for payroll verification (CLIENT-SIDE)
# Browse available providers: https://dev.reclaimprotocol.org/explore
NEXT_PUBLIC_RECLAIM_PROVIDER_ID=payroll-provider

# Optional: Your application URL (used for callbacks)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Reown AppKit Configuration (existing)
NEXT_PUBLIC_PROJECT_ID=b56e18d47c72ab683b10814fe9495694
