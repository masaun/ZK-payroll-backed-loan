{
  "name": "zk-payroll-backed-loan-contracts",
  "version": "0.1.0",
  "description": "Solana smart contracts for ZK payroll-backed lending",
  "main": "index.js",
  "scripts": {
    "build": "anchor build",
    "build:script": "./build.sh",
    "deploy:local": "./deploy.sh localnet",
    "deploy:devnet": "./deploy.sh devnet",
    "migrate:local": "cd migrations && ./migrate.sh localnet",
    "migrate:devnet": "cd migrations && ./migrate.sh devnet",
    "test": "anchor test",
    "test:verbose": "anchor test -- --nocapture",
    "test:zk": "anchor test tests/zk-credential-manager.test.ts",
    "test:lending": "anchor test tests/lending.test.ts",
    "test:borrowing": "anchor test tests/borrowing.test.ts",
    "clean": "anchor clean",
    "status": "./status.sh",
    "status:ts": "ts-node scripts/check-status.ts",
    "example:complete": "ts-node examples/complete-flow.ts",
    "example:zk": "ts-node examples/zk-proof-storage.ts",
    "example:lending": "ts-node examples/lending-pool.ts",
    "validator": "solana-test-validator",
    "logs": "solana logs"
  },
  "keywords": [
    "solana",
    "anchor",
    "lending",
    "borrowing",
    "zero-knowledge",
    "defi"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@coral-xyz/anchor": "^0.29.0",
    "@solana/web3.js": "^1.87.0",
    "@solana/spl-token": "^0.3.9",
    "chai": "^4.3.10",
    "mocha": "^10.2.0",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.3.0"
  }
}
